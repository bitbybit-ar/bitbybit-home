# Public base URL of the deployed site. Used for canonical URLs, sitemap,
# robots, Open Graph, JSON-LD. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://bitbybit.com.ar

# Lightning address shown in the Support section. The Zap CTA opens
# `lightning:<address>` which is handled by the user's Lightning wallet.
# Falls back to `bitbybit@geyser.fund` when unset — replace with the
# real address before deploy.
NEXT_PUBLIC_LIGHTNING_ADDRESS=bitbybit@geyser.fund
